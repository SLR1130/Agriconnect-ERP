APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agriconnect_erp
DB_USERNAME=root
DB_PASSWORD=

# Only for explicitly isolated local demo seeding; never commit the values.
DEMO_STAFF_PASSWORD=
DEMO_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Keep private AASMS document uploads disabled until the MAO approves its checklist
# and configures an approved malware scanner.
AGRICULTURAL_APPLICATION_DOCUMENTS_ENABLED=false
AGRICULTURAL_DOCUMENT_SCANNER_BINARY=
AGRICULTURAL_DOCUMENT_SCANNER_DATABASE_DIRECTORY=
AGRICULTURAL_DOCUMENT_SIGNATURE_MAX_AGE_HOURS=36
AGRICULTURAL_DOCUMENT_SCAN_TIMEOUT=60
AGRICULTURAL_APPLICATION_DOCUMENT_MAXIMUM_SIZE_BYTES=10485760
QUEUE_CONNECTION=database

CACHE_STORE=database
# Optional self-hosted Nominatim search endpoint. The default public endpoint is used for deliberate, user-triggered searches only.
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Phase 6C.3 staff-assisted AASMS intake is disabled by default.
# It can only run against an explicitly designated local/testing SQLite QA database.
AGRICULTURAL_STAFF_ASSISTED_INTAKE_ENABLED=false
AGRICULTURAL_STAFF_ASSISTED_QA_ISOLATED_DATABASE=false
AGRICULTURAL_STAFF_ASSISTED_QA_DATABASE_PATH=
AGRICULTURAL_STAFF_ASSISTED_SYNTHETIC_QA_ATTESTATIONS=false
AGRICULTURAL_STAFF_ASSISTED_IDENTITY_CONFIRMATION_METHODS=
AGRICULTURAL_STAFF_ASSISTED_CONSENT_POLICY_VERSION=

# Claim tickets default to QA mode. Operational mode requires an explicitly
# named ERP database and a verified private backup before schema activation.
AGRICULTURAL_CLAIM_TICKETS_ENABLED=false
AGRICULTURAL_CLAIM_TICKETS_MODE=qa
AGRICULTURAL_CLAIM_TICKETS_LIVE_ENABLED=false
AGRICULTURAL_CLAIM_TICKETS_LIVE_DATABASE=agriconnect_erp
AGRICULTURAL_CLAIM_TICKETS_LIVE_SCHEMA_APPROVED=false
AGRICULTURAL_CLAIM_TICKETS_LIVE_BACKUP_PATH=
AGRICULTURAL_CLAIM_TICKETS_LIVE_BACKUP_SHA256=
AGRICULTURAL_CLAIM_TICKETS_QA_SQLITE_PATH=
AGRICULTURAL_CLAIM_TICKETS_QA_MYSQL_DATABASE=
AGRICULTURAL_CLAIM_TICKETS_VALIDITY_DAYS=
AGRICULTURAL_CLAIM_TICKETS_PICKUP_INSTRUCTIONS=
AGRICULTURAL_CLAIM_TICKETS_OFFICE_NAME=
AGRICULTURAL_CLAIM_TICKETS_OFFICE_ADDRESS=
AGRICULTURAL_CLAIM_HANDOVER_ENABLED=false
AGRICULTURAL_CLAIM_HANDOVER_OPERATIONAL_LABEL=

VITE_APP_NAME="${APP_NAME}"
